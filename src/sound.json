{
  "_doc": "How tools/audio.py drives this game's sound engine. RAM names come from ram.inc.",
  "init": "InitSound",
  "update": "UpdateSound",
  "power_on": [["rNR52", 128], ["rNR51", 255], ["rNR50", 119]],
  "stack": "0xCFFF",
  "pause": {"var": "wSoundPause", "on": 1, "off": 2},
  "kinds": {
    "music": {"label": "Music", "request": "wMusicRequest", "playing": "wCurrentSong", "ids": [1, 17], "loops": true, "max_seconds": 150},
    "sfx":   {"label": "Sound effects (square channel)", "request": "wSFXRequest", "playing": "wSFXPlaying", "ids": [1, 8], "max_seconds": 8},
    "wave":  {"label": "Sound effects (wave channel)", "request": "wWaveSFXRequest", "playing": "wWaveSFXPlaying", "ids": [1, 2], "max_seconds": 8},
    "noise": {"label": "Sound effects (noise channel)", "request": "wNoiseSFXRequest", "playing": "wNoiseSFXPlaying", "ids": [1, 4], "max_seconds": 8}
  },
  "music_channels": {
    "_doc": "per channel: its RAM struct, the offset of the pattern pointer (the note just played is the byte before it), the pattern list pointer, and the flag byte/bit set while a sound effect owns the channel",
    "structs": ["wChannel1", "wChannel2", "wChannel3", "wChannel4"],
    "pattern_ptr": 4,
    "list_ptr": 0,
    "effect_flag": [15, 128]
  },
  "song_data": {"table": "SongTable", "count": 17, "region_end": "UpdateSound", "path": "sound/music/songs"},
  "effect_channels": {"sfx": [0], "wave": [0, 1, 2, 3], "noise": [3]},
  "names": {
    "music 1": ["High score name entry", "State15_NameEntry / UpdateHighScores"],
    "music 2": ["Lines cleared (type B win) jingle", "RefreshBoardRow0"],
    "music 3": ["Title screen", "State06_TitleScreenInit"],
    "music 4": ["Game over jingle", "State0D_GameOverScreen"],
    "music 5": ["A-TYPE music (Korobeiniki)", "PlaySelectedMusic"],
    "music 6": ["B-TYPE music", "PlaySelectedMusic"],
    "music 7": ["C-TYPE music", "PlaySelectedMusic"],
    "music 8": ["2-player danger (stack 12+ rows)", "CheckStackHeight"],
    "music 9": ["2-player round over", "State1D_VersusWon / State1E_VersusLost"],
    "music 10": ["Dancers ending, height 0", "State22_DancersInit"],
    "music 11": ["Dancers ending, height 1", "State22_DancersInit"],
    "music 12": ["Dancers ending, height 2", "State22_DancersInit"],
    "music 13": ["Dancers ending, height 3", "State22_DancersInit"],
    "music 14": ["Dancers ending, height 4", "State22_DancersInit"],
    "music 15": ["Dancers ending, height 5", "State22_DancersInit"],
    "music 16": ["Rocket / shuttle launch", "State26_ShuttleInit / State2E_RocketInit"],
    "music 17": ["2-player match over", "State1D_VersusWon / State1E_VersusLost"],
    "sfx 1": ["Menu cursor", "menus, SetupObjectWithSFX"],
    "sfx 2": ["Confirm / tally count / letter typed", "ConfirmGameMenu, tally, State2C_TypeMessage"],
    "sfx 3": ["Rotate", "HandlePieceInput"],
    "sfx 4": ["Move left/right", "HandlePieceInput"],
    "sfx 5": ["Garbage rising (2-player)", "RefreshBoardRow11"],
    "sfx 6": ["Line clear", "CheckLines"],
    "sfx 7": ["Tetris (4 lines)", "CheckLines"],
    "sfx 8": ["Level up", "CheckLevelUp"],
    "wave 1": ["Tetris (4 lines), second half", "UpdateSFX7"],
    "wave 2": ["Game over: stack reached the top", "UpdateFall"],
    "noise 1": ["Rows fall into place", "RefreshBoardRow11"],
    "noise 2": ["Piece locks", "CheckLines"],
    "noise 3": ["Smoke puff (endings)", "FlickerSmoke"],
    "noise 4": ["Rocket engine", "State02_ShuttleLiftoff / State31_RocketLiftoff"]
  }
}
